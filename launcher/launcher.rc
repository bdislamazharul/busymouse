#include <windows.h>
#include "version.h"  // VER_COMMA and VER_TEXT, written by tools\package.ps1

1 ICON "..\\BusyMouse.WinUI\\Assets\\BusyMouse.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_COMMA
 PRODUCTVERSION VER_COMMA
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Azharul Islam"
      VALUE "FileDescription", "BusyMouse"
      VALUE "FileVersion", VER_TEXT
      VALUE "ProductName", "BusyMouse"
      VALUE "ProductVersion", VER_TEXT
      VALUE "LegalCopyright", "\xa9 2026 Azharul Islam"
      VALUE "OriginalFilename", "BusyMouse.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
