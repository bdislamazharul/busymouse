<?xml version="1.0" encoding="utf-8"?>
<!--
  Bundle WITHOUT the .NET runtime: much smaller, but the PC needs the .NET 10 Runtime (x64 or ARM64).
  The launcher BusyMouse.exe offers to download and install it when it is missing.
  Build both bundles, the launcher and the installers with tools\package.ps1.
    dotnet publish BusyMouse.WinUI -c Release -p:Platform=x64 -p:PublishProfile=NoRuntime
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <!-- Also run on a newer .NET (11, 12, ...) when 10 isn't installed. -->
    <RollForward>Major</RollForward>
    <!-- The app goes in "app"; the native launcher (launcher\launcher.cpp) sits above it as BusyMouse.exe. -->
    <PublishDir>bin\publish\$(Platform)\no-runtime\app\</PublishDir>
  </PropertyGroup>
</Project>
