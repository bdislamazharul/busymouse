<?xml version="1.0" encoding="utf-8"?>
<!--
  Bundle WITH the .NET runtime: runs on any Windows 10/11 PC, nothing to install.
    dotnet publish BusyMouse.WinUI -c Release -p:Platform=x64 -p:PublishProfile=WithRuntime
  Add -p:PublishTrimmed=true to strip unused .NET code (much smaller; test the app afterwards).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\$(Platform)\with-runtime\</PublishDir>
  </PropertyGroup>
</Project>
