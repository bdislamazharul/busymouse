<UserControl
    x:Class="BusyMouse.WinUI.Controls.TimeLimitPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BusyMouse.WinUI.Controls"
    IsTabStop="False">

  <UserControl.Resources>
    <DataTemplate x:Key="RecentRowTemplate" x:DataType="local:LimitRow">
      <Grid ColumnSpacing="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Height="32"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="{x:Bind Pick}"
            FontSize="13"
            Style="{StaticResource SubtleButtonStyle}">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:StrokeIcon Width="14" Height="14" Data="M3.5 10a6.5 6.5 0 1 0 2-4.7M3.5 3.5v3h3M10 6.5V10l2.5 1.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" />
          </Grid>
        </Button>
        <Button Grid.Column="1"
            Width="28"
            Height="28"
            Padding="0"
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Bind RemoveName}"
            Click="{x:Bind Remove}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource SubtleButtonStyle}">
          <FontIcon FontSize="10" Glyph="&#xE711;" />
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel x:Name="Root" Spacing="4">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="EntryStates">
        <VisualState x:Name="EntryRest" />
        <VisualState x:Name="EntryFocused">
          <VisualState.Setters>
            <Setter Target="EntryFrame.Background" Value="{ThemeResource ControlFillColorInputActiveBrush}" />
            <Setter Target="EntryUnderline.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="HintStates">
        <VisualState x:Name="HintNormal" />
        <VisualState x:Name="HintError">
          <VisualState.Setters>
            <Setter Target="Hint.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ListPlaces">
        <VisualState x:Name="ListInPopup" />
        <!-- In line under the box it's one more card on the page. -->
        <VisualState x:Name="ListInline">
          <VisualState.Setters>
            <Setter Target="ListFrame.Margin" Value="0" />
            <Setter Target="ListFrame.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Target="ListFrame.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Target="ListFrame.CornerRadius" Value="6" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid Height="16" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Caption" Style="{StaticResource CaptionTextStyle}" Text="Keep awake for" />
      <TextBlock x:Name="Hint"
          Grid.Column="1"
          HorizontalAlignment="Right"
          AutomationProperties.LiveSetting="Polite"
          Style="{StaticResource CaptionTextStyle}"
          TextTrimming="CharacterEllipsis" />
    </Grid>

    <Grid Height="34">
      <!-- The five choices -->
      <Border x:Name="Segments"
          Padding="2"
          AutomationProperties.LabeledBy="{x:Bind Caption}"
          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid x:Name="SegmentGrid" ColumnSpacing="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="TwoHoursColumn" Width="*" />
            <ColumnDefinition x:Name="CustomColumn" Width="*" />
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="NoLimit"
              AutomationProperties.Name="No time limit"
              Click="Segment_Click"
              Style="{StaticResource SegmentToggleStyle}"
              ToolTipService.ToolTip="Keep awake until you turn it off">
            <local:StrokeIcon Data="M10 10C8.5 7.8 7.2 7 5.8 7a3 3 0 0 0 0 6c1.4 0 2.7-0.8 4.2-3s2.8-3 4.2-3a3 3 0 0 1 0 6c-1.4 0-2.7-0.8-4.2-3" />
          </ToggleButton>
          <ToggleButton x:Name="HalfHour"
              Grid.Column="1"
              AutomationProperties.Name="30 minutes"
              Click="Segment_Click"
              Content="30 min"
              Style="{StaticResource SegmentToggleStyle}"
              ToolTipService.ToolTip="Turn off after 30 minutes" />
          <ToggleButton x:Name="OneHour"
              Grid.Column="2"
              AutomationProperties.Name="1 hour"
              Click="Segment_Click"
              Content="1 h"
              Style="{StaticResource SegmentToggleStyle}"
              ToolTipService.ToolTip="Turn off after 1 hour" />
          <ToggleButton x:Name="TwoHours"
              Grid.Column="3"
              AutomationProperties.Name="2 hours"
              Click="Segment_Click"
              Content="2 h"
              Style="{StaticResource SegmentToggleStyle}"
              ToolTipService.ToolTip="Turn off after 2 hours" />
          <ToggleButton x:Name="Custom"
              Grid.Column="4"
              Click="Segment_Click"
              Style="{StaticResource SegmentToggleStyle}" />
        </Grid>
      </Border>

      <!-- Typing a custom time -->
      <Grid x:Name="Editor" VerticalAlignment="Center" ColumnSpacing="4" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="EntryFrame"
            Height="32"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource TextControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <local:StrokeIcon Margin="8,0,0,0" Data="M10 3a7 7 0 1 1 0 14a7 7 0 1 1 0-14M10 6.5V10l2.5 1.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBox x:Name="Entry"
              Grid.Column="1"
              MinWidth="0"
              Padding="6,5,4,6"
              VerticalAlignment="Center"
              AutomationProperties.Name="Custom time"
              FontSize="13"
              GotFocus="Entry_FocusChanged"
              IsSpellCheckEnabled="False"
              IsTextPredictionEnabled="False"
              KeyDown="Entry_KeyDown"
              LostFocus="Entry_FocusChanged"
              PlaceholderText="e.g. 2h 30m"
              TextChanged="Entry_TextChanged">
            <TextBox.Resources>
              <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
              <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </TextBox.Resources>
          </TextBox>
          <Button x:Name="ListButton"
              Grid.Column="2"
              Width="28"
              Height="30"
              Padding="0"
              HorizontalContentAlignment="Center"
              AutomationProperties.Name="Recent times"
              Click="ListButton_Click"
              CornerRadius="0,3,3,0"
              IsTabStop="False"
              Style="{StaticResource SubtleButtonStyle}">
            <FontIcon FontSize="10" Glyph="&#xE70D;" />
          </Button>
          <Rectangle x:Name="EntryUnderline"
              Grid.ColumnSpan="3"
              Height="2"
              VerticalAlignment="Bottom"
              Fill="{ThemeResource AccentFillColorDefaultBrush}"
              Visibility="Collapsed" />
        </Grid>

        <Button x:Name="SaveButton"
            Grid.Column="1"
            Height="32"
            Padding="0"
            HorizontalAlignment="Stretch"
            Click="SaveButton_Click"
            Content="Save"
            FontSize="12"
            IsEnabled="False"
            Style="{StaticResource AccentButtonStyle}" />
        <Button Grid.Column="2"
            Height="32"
            Padding="0"
            HorizontalAlignment="Stretch"
            Click="CancelButton_Click"
            Content="Cancel"
            FontSize="12" />

        <Popup x:Name="ListPopup" IsLightDismissEnabled="False">
          <Border x:Name="ListFrame"
              Margin="0,4"
              Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
              BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
              BorderThickness="1"
              CornerRadius="8">
            <ScrollViewer MaxHeight="268" Padding="4" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Button x:Name="TypedRow"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Click="TypedRow_Click"
                    FontSize="13"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="Collapsed">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:StrokeIcon Width="14" Height="14" Data="M15 5v5a2 2 0 0 1-2 2H5M8 9l-3 3l3 3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
                    <TextBlock x:Name="TypedLabel" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TypedDetail" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </Grid>
                </Button>

                <Grid x:Name="RecentHeader" Height="28" Padding="8,0,2,0">
                  <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="Recent" />
                  <Button Height="24"
                      HorizontalAlignment="Right"
                      Click="ClearRecents_Click"
                      Content="Clear all"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      Style="{StaticResource SubtleButtonStyle}" />
                </Grid>
                <ItemsControl x:Name="RecentList" IsTabStop="False" ItemTemplate="{StaticResource RecentRowTemplate}" />

                <Border x:Name="HelpLine" Padding="8,6,8,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                  <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Type any length: 45m, 2h 30m, 1:15, 3d or until 6 pm" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Popup>
      </Grid>
    </Grid>

    <!-- Where the list goes in the window: below the box, moving what's under it down instead of covering it. -->
    <Border x:Name="ListHost" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
