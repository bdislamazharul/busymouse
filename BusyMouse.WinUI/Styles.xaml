<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AvatarOneBackground" Color="#DCEBFA" />
      <SolidColorBrush x:Key="AvatarOneForeground" Color="#004E99" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AvatarOneBackground" Color="#1F3A52" />
      <SolidColorBrush x:Key="AvatarOneForeground" Color="#9FD3FF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="AvatarOneBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
      <SolidColorBrush x:Key="AvatarOneForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="CardRowStyle" TargetType="Grid">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="ColumnSpacing" Value="12" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- A Settings row: a name with a line of explanation under it, and its control on the right. -->
  <Style x:Key="SettingRowStyle" TargetType="Grid">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="ColumnSpacing" Value="12" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- An accent color to pick: the color in a rounded square, ringed and ticked while it's the one in use.
       Background is the color; Foreground is the tick, black or white to stand out on it. -->
  <Style x:Key="SwatchToggleStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
    <Setter Property="FocusVisualMargin" Value="-2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="4" />
            <Border x:Name="Ring" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="2" CornerRadius="4" Opacity="0" />
            <Border x:Name="Gap" Margin="2" BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="1.5" CornerRadius="2" Opacity="0" />
            <FontIcon x:Name="Tick" FontSize="14" Foreground="{TemplateBinding Foreground}" Glyph="&#xE73E;" Opacity="0" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Ring.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Fill.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Ring.Opacity" Value="1" />
                    <Setter Target="Gap.Opacity" Value="1" />
                    <Setter Target="Tick.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Ring.Opacity" Value="1" />
                    <Setter Target="Gap.Opacity" Value="1" />
                    <Setter Target="Tick.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Fill.Opacity" Value="0.8" />
                    <Setter Target="Ring.Opacity" Value="1" />
                    <Setter Target="Gap.Opacity" Value="1" />
                    <Setter Target="Tick.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Compact switch: just the track and knob, no On/Off text beside it. -->
  <Style x:Key="BareToggleSwitchStyle" TargetType="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <!-- The template keeps a fixed 12px gap after the track for the On/Off text, and left to size itself the
         switch still asks for its full 154px. Size it to track plus gap, and let the empty gap hang past the edge. -->
    <Setter Property="Width" Value="52" />
    <Setter Property="Margin" Value="0,0,-12,0" />
    <Setter Property="FocusVisualMargin" Value="-7,-3,5,-3" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A borderless button that shows a light fill on hover, like a Fluent subtle button. -->
  <Style x:Key="SubtleButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter x:Name="ContentPresenter"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              Foreground="{TemplateBinding Foreground}"
              AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The subtle button as a toggle; stays lightly filled while checked (the About button). -->
  <Style x:Key="SubtleToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <ContentPresenter x:Name="ContentPresenter"
              Background="{TemplateBinding Background}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              Foreground="{TemplateBinding Foreground}"
              AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Title-bar buttons, drawn by the app since the window keeps only Minimize and Exit. -->
  <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter x:Name="ContentPresenter"
              Background="{TemplateBinding Background}"
              Content="{TemplateBinding Content}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Foreground="{TemplateBinding Foreground}"
              AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="#C42B1C" />
                    <Setter Target="ContentPresenter.Foreground" Value="White" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="#E6C42B1C" />
                    <Setter Target="ContentPresenter.Foreground" Value="#B3FFFFFF" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Mode tile: a control-filled box that tints with the accent while selected. -->
  <Style x:Key="TileToggleStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="Tint" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="5" Opacity="0" />
            <Border x:Name="Overlay" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="5" Opacity="0" />
            <ContentPresenter x:Name="ContentPresenter"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Foreground="{TemplateBinding Foreground}"
                AutomationProperties.AccessibilityView="Raw" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Tint.Opacity" Value="0.12" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Tint.Opacity" Value="0.12" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Tint.Opacity" Value="0.12" />
                    <Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Tint.Opacity" Value="0.12" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Flyout mode tile: the same box, 52 high, with the mode's name (from Tag) underneath. -->
  <Style x:Key="FlyoutTileToggleStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid RowSpacing="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="52" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="Box"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
              <Border x:Name="Tint" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="5" Opacity="0" />
              <Border x:Name="Overlay" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="5" Opacity="0" />
              <ContentPresenter x:Name="ContentPresenter"
                  Content="{TemplateBinding Content}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Foreground="{TemplateBinding Foreground}"
                  AutomationProperties.AccessibilityView="Raw" />
            </Grid>
            <TextBlock x:Name="Label"
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontSize="12"
                LineHeight="16"
                Foreground="{TemplateBinding Foreground}"
                Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                AutomationProperties.AccessibilityView="Raw" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Tint.Opacity" Value="0.12" />
                    <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Tint.Opacity" Value="0.12" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                    <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Tint.Opacity" Value="0.12" />
                    <Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                    <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One segment of "Keep awake for": plain text that becomes a raised chip with an accent pill when chosen. -->
  <Style x:Key="SegmentToggleStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
    <Setter Property="FocusVisualMargin" Value="-1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="Overlay" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Opacity="0" />
            <ContentPresenter x:Name="ContentPresenter"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Foreground="{TemplateBinding Foreground}"
                TextWrapping="NoWrap"
                AutomationProperties.AccessibilityView="Raw" />
            <Rectangle x:Name="Pill"
                Width="14"
                Height="3"
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                RadiusX="1.5"
                RadiusY="1.5"
                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                Visibility="Collapsed" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                    <Setter Target="Pill.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                    <Setter Target="Pill.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                    <Setter Target="Pill.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The round On/Off button: a card-coloured disc that fills with the accent while on. The mouse glyph sits on top of it, outside the template, so it can be animated. -->
  <Style x:Key="PowerToggleStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Ellipse x:Name="Disc"
                Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                StrokeThickness="1" />
            <Ellipse x:Name="Overlay" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Fill" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Disc.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Setter Target="Disc.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Disc.Fill" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                    <Setter Target="Disc.Stroke" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Disc.Fill" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                    <Setter Target="Disc.Stroke" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The pin beside the hourglass texts: an outline pin that fills in while pinned. -->
  <Style x:Key="PinToggleStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
    <Setter Property="FocusVisualMargin" Value="-1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <Border x:Name="Overlay" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Opacity="0" />
            <Viewbox Width="14" Height="14">
              <Canvas Width="20" Height="20">
                <Path x:Name="Head"
                    Data="M6.5,3.5 H13.5 M8,3.5 V8 L5.5,11 H14.5 L12,8 V3.5"
                    Fill="Transparent"
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeLineJoin="Round"
                    StrokeThickness="1.5" />
                <Path x:Name="Needle"
                    Data="M10,11 V17"
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.5" />
              </Canvas>
            </Viewbox>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Head.Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Target="Head.Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Target="Needle.Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Opacity" Value="1" />
                    <Setter Target="Head.Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Target="Head.Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Target="Needle.Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="Overlay.Opacity" Value="1" />
                    <Setter Target="Head.Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Target="Head.Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Target="Needle.Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A command-line option in About. -->
  <Style x:Key="ChipStyle" TargetType="Border">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="ChipTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <!-- DropDown: the box's chevron, the list's frame and its rows, measured like the stock combo box's. A row's
       text lines up with the box's: 1 for the frame plus 12 of padding. -->
  <Style x:Key="DropDownGlyphStyle" TargetType="FontIcon">
    <Setter Property="Glyph" Value="&#xE70D;" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,14,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{ThemeResource ComboBoxDropDownGlyphForeground}" />
    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
  </Style>

  <Style x:Key="DropDownPresenterStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="Background" Value="{ThemeResource ComboBoxDropDownBackground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ComboBoxDropDownBorderBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style x:Key="DropDownItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,5,12,7" />
  </Style>

</ResourceDictionary>
